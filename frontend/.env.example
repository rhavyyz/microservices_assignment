# Copie para ".env" (ignorado pelo git). Valores VITE_* são PÚBLICOS depois do build: nunca coloque segredos aqui.
# URL pública do API Gateway (sem barra final). O frontend não conhece nenhum outro endereço de backend.
# Com o docker compose da raiz o Gateway publica a porta 8080 no host.
VITE_API_BASE_URL=http://localhost:8080
