# Copie para ".env" (ignorado pelo git) e ajuste. TODOS os valores abaixo são FICTÍCIOS: não reutilize em produção.
# O docker compose lê o .env da raiz do repositório. Para o compose do serviço isolado use: --env-file .env

# --- Serviço de Usuários: banco (PostgreSQL privado "user-db") ---
USERS_DB_USER=users
# Sem valor padrão no compose: sem esta variável o user-db não inicia (evita senha conhecida).
USERS_DB_PASSWORD=troque-esta-senha-local
# Porta no loopback do host, apenas com user/docker-compose.dev.yml (desenvolvimento fora do Docker).
USERS_DB_HOST_PORT=5433

# --- Serviço Certificates: banco (PostgreSQL privado "certificates-db") ---
CERTIFICATES_DB_USER=certificates
# Senha fictícia apenas para desenvolvimento local: ajuste antes de iniciar o serviço.
CERTIFICATES_DB_PASSWORD=troque-esta-senha-certificates
# URL interna usada pela aplicação; mantenha usuário e senha consistentes com as variáveis acima.
CERTIFICATES_DATABASE_URL=postgresql+psycopg://certificates:troque-esta-senha-certificates@certificates-db:5432/certificates
# Armazenamento dos PDFs (SeaweedFS privado "certificates-s3", sem porta no host). Sem valor padrão no compose:
# sem estas variáveis o S3 não inicia (evita chave conhecida).
CERTIFICATES_S3_ACCESS_KEY=certificates-s3
CERTIFICATES_S3_SECRET_KEY=troque-esta-senha-s3

# --- Serviço de Usuários: Access Token (JWT RS256) ---
# A chave privada NÃO fica em variável: gere com user/scripts/gen-dev-keys.sh (user/.keys/jwt-private.pem, ignorado
# pelo git); o compose a monta em /run/keys. Em outros ambientes, monte-a como segredo.
# ATENÇÃO: o Gateway valida o `iss` com JWT_ISSUER (padrão eventhub-users) e o compose NÃO repassa este valor a ele.
# Se mudar o emissor aqui, defina também JWT_ISSUER no serviço `gateway`, senão todo token será recusado.
USERS_JWT_ISSUER=eventhub-users
USERS_JWT_TTL_SECONDS=1800
# Fator de custo do BCrypt (OWASP: 10 ou mais).
USERS_BCRYPT_STRENGTH=12

# --- Organizador de demonstração (SOMENTE desenvolvimento local; desativado por padrão) ---
USERS_DEV_SEED_ENABLED=false
USERS_DEV_SEED_NAME=Organizador de Demonstração
USERS_DEV_SEED_EMAIL=organizador@example.test
USERS_DEV_SEED_PASSWORD=troque-esta-senha-de-demo

# --- Serviço de Inscrições: banco (PostgreSQL privado "subscription-db") ---
# Sem valor padrão no compose: sem esta variável o subscription-db não inicia (evita senha conhecida).
# A URL de conexão é montada a partir dela; se a senha tiver caracteres reservados de URL, use percent-encoding
# e defina SUBSCRIPTION_DATABASE_URL explicitamente.
SUBSCRIPTION_DB_PASSWORD=troque-esta-senha-local
# SUBSCRIPTION_DATABASE_URL=
# RESERVATION_SECONDS=900
# OFFER_SECONDS=600

# --- Frontend ---
# A configuração do frontend fica em frontend/.env (veja frontend/.env.example): VITE_API_BASE_URL, URL pública do Gateway.
