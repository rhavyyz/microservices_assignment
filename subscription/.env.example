# O docker compose lê o .env da RAIZ do repositório (copie estas variáveis para lá; ver .env.example da raiz).
# Valores FICTÍCIOS. A senha é a única fonte: a URL do banco é montada a partir dela.
SUBSCRIPTION_DB_PASSWORD=replace-with-local-password
# Opcional: URL completa (use percent-encoding se a senha tiver caracteres reservados).
# SUBSCRIPTION_DATABASE_URL=postgresql://subscription:replace-with-local-password@subscription-db:5432/subscription
# RESERVATION_SECONDS=900
# OFFER_SECONDS=600
# RECONCILE_SECONDS=60
